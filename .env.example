API_PORT=8787
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-development-secret
DATABASE_PATH=./nirmala.sqlite
# Kop dan penandatangan cetak CHR (opsional; nama dan NIP boleh kosong)
PRINT_ORGANIZATION_NAME=Kementerian Pekerjaan Umum
PRINT_UNIT_NAME=Inspektorat Jenderal
PRINT_ADDRESS=
PRINT_SIGNATORY_CITY=Jakarta
PRINT_SIGNATORY_TITLE=Inspektur Jenderal
PRINT_SIGNATORY_NAME=
PRINT_SIGNATORY_NIP=
# Halaman publik: ambang penggabungan eselon I (k) dan penanda data sintetis (demo)
PUBLIC_MIN_NOTES=5
PUBLIC_DATA_SYNTHETIC=true
# Produksi (npm start): API_HOST (default 127.0.0.1), WEB_DIST_DIR (default apps/web/dist), BACKUP_DIR, BACKUP_KEEP_DAYS.
# Lihat docs/deploy.md dan deploy/nirmala.env.example.
