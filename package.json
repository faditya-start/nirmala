{
  "name": "nirmala",
  "private": true,
  "version": "0.1.0",
  "description": "NIRMALA - Budget Review & Follow-up Intelligence",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @nirmala/api\" \"npm run dev -w @nirmala/web\"",
    "build": "npm run build -w @nirmala/shared && npm run build -w @nirmala/web && npm run build -w @nirmala/api",
    "typecheck": "npm run typecheck -w @nirmala/shared && npm run typecheck -w @nirmala/web && npm run typecheck -w @nirmala/api",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @nirmala/api",
    "db:migrate": "npm run db:migrate -w @nirmala/api",
    "db:seed": "npm run db:seed -w @nirmala/api",
    "start": "npm run start -w @nirmala/api",
    "backup": "npm run backup -w @nirmala/api",
    "e2e:rest": "node e2e/rest.mjs",
    "e2e:core": "node e2e/core-loop.mjs",
    "e2e:core:fresh": "e2e/with-stack.sh node e2e/core-loop.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.3"
  }
}
