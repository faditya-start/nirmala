# Contoh /etc/nirmala/nirmala.env (pemilik root:nirmala, izin 0640). Jangan di-commit berisi nilai asli.
# Nilai berspasi diberi tanda kutip supaya aman dipakai systemd (EnvironmentFile) maupun `. berkas` di bash.
NODE_ENV=production
API_PORT=8787
# Default produksi: hanya 127.0.0.1 (cloudflared di mesin yang sama). Ubah hanya bila perlu.
# API_HOST=127.0.0.1
# Origin publik aplikasi (https), dipakai untuk CORS. Satu origin dengan web, jadi cukup domain tunnel.
WEB_ORIGIN=https://nirmala.contoh.go.id
# WAJIB di produksi (server menolak start tanpa ini). Buat: openssl rand -base64 48
SESSION_SECRET=GANTI-DENGAN-ACAK-PANJANG
DATABASE_PATH=/var/lib/nirmala/nirmala.sqlite
# Folder hasil build web; default apps/web/dist.
# WEB_DIST_DIR=/opt/nirmala/apps/web/dist

# Halaman publik (P2): ambang penggabungan eselon I (k) dan penanda data sintetis.
PUBLIC_MIN_NOTES=5
PUBLIC_DATA_SYNTHETIC=false

# Kop dan penandatangan cetak CHR (nama dan NIP boleh kosong)
PRINT_ORGANIZATION_NAME="Kementerian Pekerjaan Umum"
PRINT_UNIT_NAME="Inspektorat Jenderal"
PRINT_ADDRESS=
PRINT_SIGNATORY_CITY=Jakarta
PRINT_SIGNATORY_TITLE="Inspektur Jenderal"
PRINT_SIGNATORY_NAME=
PRINT_SIGNATORY_NIP=

# Cadangan harian
BACKUP_DIR=/var/backups/nirmala
BACKUP_KEEP_DAYS=14
