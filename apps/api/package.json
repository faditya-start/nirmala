{
  "name": "@nirmala/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build -w @nirmala/shared && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/db/seedDemoLoop.ts",
    "db:seed:e2e": "tsx src/db/seedE2e.ts",
    "generate:synthetic": "tsx scripts/generate-synthetic.ts",
    "import:private": "tsx scripts/import-private.ts",
    "import:answer-key": "tsx scripts/import-answer-key.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "bootstrap:production": "tsx scripts/bootstrap-production.ts",
    "backup": "tsx scripts/backup.ts",
    "start": "NODE_ENV=production tsx src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@nirmala/shared": "0.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
